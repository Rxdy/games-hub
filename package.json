{
  "name": "games-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hub vitrine des jeux de Rudy — games.rxdy.fr",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --grep-invert @capture",
    "captures": "playwright test --grep @capture"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-ssg": "^28.0.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.0.0"
  }
}
